{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nome do Worker = subdomínio em https://<name>.<subdomínio>.workers.dev. No deploy do
  // GitHub o nome vem do repositório (ou da variável CLOUDFLARE_WORKER_NAME), com o sufixo
  // "-staging" no staging; este valor só vale para um `wrangler deploy` local.
  "name": "elfo-template-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // A SPA é servida como static assets. Rotas que não existem como arquivo
    // caem no index.html; /api/* sempre passa primeiro pelo Worker (Hono).
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // URL pública em workers.dev. Fica ligada mesmo com domínio próprio: o smoke test do deploy
  // e o staging usam ela.
  "workers_dev": true,
  // Domínio próprio (opcional, só produção: o deploy de staging ignora `routes`). O domínio
  // precisa estar na mesma conta da Cloudflare. Veja "Domínio próprio" no README.
  // "routes": [{ "pattern": "app.minhaempresa.com.br", "custom_domain": true }],
  "vars": {
    "APP_NAME": "Elfo Web",
    // URL pública do app, usada pelo Better Auth (links de email, callbacks do
    // OAuth). Vazia = a origem de cada request: funciona sem configurar nada no
    // *.workers.dev, no staging, num domínio próprio e no dev. Vale para production
    // E staging, então só defina (ex.: "https://app.exemplo.com") se precisar de uma
    // URL fixa, sabendo que o staging também passa a usá-la nos links e callbacks.
    "BETTER_AUTH_URL": ""
  },
  "secrets": {
    // Connection string do Postgres (Neon). Em dev, vem do .dev.vars ou, sem
    // ela, do PGlite local que o `pnpm dev` sobe (ver vite.config.ts).
    // BETTER_AUTH_SECRET assina os cookies de sessão (Elfo gera em produção;
    // no dev/preview, sem ela no .dev.vars, o vite.config.ts usa uma de dev).
    // Os de OAuth (OAUTH_GITHUB_*, OAUTH_GOOGLE_*) são opcionais e por isso NÃO ficam aqui:
    // ver worker/types.ts.
    "required": ["DATABASE_URL", "BETTER_AUTH_SECRET"]
  }
  // Hyperdrive (opcional): pool de conexões na borda, na frente do Neon.
  // Veja "Banco de dados → Hyperdrive" no CLAUDE.md antes de ativar.
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id do hyperdrive>" }]
}
